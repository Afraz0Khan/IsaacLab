{
  "x_velocity": "x_velocity",
  "ctrl_cost": "np.sum(np.square(action))",
  "tanh_v": "np.tanh(x_velocity)",
  "x_vel_sq": "x_velocity**2",
  "sqrt_speed": "np.sign(x_velocity)*np.sqrt(np.abs(x_velocity))",
  "ctrl_cost_sq": "(np.sum(np.square(action)))**2",
  "x_vel": "x_velocity",
  "abs_pitch": "np.abs(state[2])",
  "speed_pow": "np.sign(x_velocity)*np.abs(x_velocity)**1.5",
  "forward_lean": "-state[2]",
  "speed_torso": "x_velocity * env.get_body_com('torso')[2]",
  "torso_z": "env.get_body_com('torso')[2]",
  "joint_vel_sq": "np.sum(np.square(state[11:]))",
  "ang_vel_sq": "np.sum(np.square(state[11:]))",
  "eff_penalty": "ctrl_cost/(np.abs(x_velocity)+1e-6)",
  "efficiency": "x_velocity/(ctrl_cost+1e-6)",
  "log_speed": "np.log1p(np.abs(x_velocity))*np.sign(x_velocity)",
  "l1_torque": "np.sum(np.abs(action))",
  "abs_front_foot_angle": "np.abs(state[8])",
  "abs_torso_z_vel": "np.abs(state[10])",
  "torso_z_vel": "np.abs(state[10])",
  "exp_speed": "np.exp(0.3 * x_velocity)",
  "accel_sq": "(next_state[9]-state[9])**2",
  "speed_mod": "x_velocity/(1.0+np.abs(state[8]))",
  "jerk_sq": "np.sum(np.square(next_state[11:]-state[11:]))"
}